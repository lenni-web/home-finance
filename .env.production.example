DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=192.168.1.10,localhost
DJANGO_SECURE_COOKIES=0
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_LOG_LEVEL=INFO
POSTGRES_DB=ausgaben
POSTGRES_USER=ausgaben
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
APP_BIND=0.0.0.0
APP_PORT=8000
GUNICORN_WORKERS=2
EMAIL_CREDENTIAL_KEY=replace-with-another-long-random-secret
DEPLOY_REVISION=local
BACKUP_RETENTION_DAYS=7
BACKUP_MONTHLY_COPIES=6
# Optional: GPG-Schlüssel-ID für verschlüsselte Backups. Auf dem Server muss
# der öffentliche Schlüssel bereits im Schlüsselbund vorhanden sein.
BACKUP_GPG_RECIPIENT=
